<ul class="navigation relative flex m-0 p-0 list-unstyled capitalize">
  {%- for block in se_blocks -%}
    {%- case block.type -%}
      {%- when 'dropdown' -%}
        <li
          id="item_{{block.id}}"
          class="type_{{block.type}} menu-item{% if linklists[block.settings.menu].links.size > 0 %} has-children {% endif %}"
        >
          <a
            class="item-title"
            href="{% if block.settings.link != blank %}{{block.settings.link}}{% else %}#{% endif %}"
            target="{{block.settings.open_link}}"
          >
            <span class="flex items-center gap-2">
              {{- block.settings.text | strip_html -}}
              {%- render 'icon-arrow-up', size: 14 -%}
            </span>
          </a>
          {%- if linklists[block.settings.menu].links.size > 0 -%}
            <ul class="sub-menu absolute">
              {%- for lv2 in linklists[block.settings.menu].links -%}
                <li class="menu-item">
                  <a href="{{ lv2.url }}" class="item-title">
                    <span class="flex items-center justify-between gap-2">
                      {{- lv2.title | strip_html -}}
                      {%- if lv2.links.size > 0 -%}
                        {%- render 'icon-arrow-up', size: 14 -%}
                      {% endif %}
                    </span>
                  </a>

                  {%- if lv2.links.size > 0 -%}
                    <ul class="sub-menu level-2">
                      {%- for lv3 in lv2.links -%}
                        <li class="menu-item">
                          <a href="{{ lv3.url }}" class="item-title ">
                            <span class="flex items-center  justify-between gap-2">
                              {{- lv3.title | strip_html -}}
                              {%- if lv3.links.size > 0 -%}
                                {%- render 'icon-arrow-up', size: 14 -%}
                              {% endif %}
                            </span>
                          </a>

                          {%- if lv3.links.size > 0 -%}
                            <ul class="sub-menu level-3">
                              {%- for lv4 in lv3.links -%}
                                <li class="menu-item">
                                  <a href="{{ lv4.url }}" class="item-title"
                                    ><span>{{- lv4.title | strip_html -}}</span></a
                                  >
                                </li>
                              {%- endfor -%}
                            </ul>
                          {%- endif -%}
                        </li>
                      {%- endfor -%}
                    </ul>
                  {%- endif -%}
                </li>
              {%- endfor -%}
            </ul>
          {%- endif -%}
        </li>

      {%- when 'mega_2' -%}
        <li
          id="item_{{block.id}}"
          class="type_{{block.type}} position-initial menu-item{% if linklists[block.settings.menu].links.size > 0 %} has-children {% endif %}"
        >
          <a
            class="item-title"
            href="{% if block.settings.link != blank %}{{block.settings.link}}{% else %}#{% endif %}"
            target="{{block.settings.open_link}}"
          >
            <span class="flex items-center gap-2">
              {{ block.settings.text | strip_html }}
              {% render 'icon-arrow-up', size: 14 %}
            </span>
          </a>
          {%- if linklists[block.settings.menu].links.size > 0 -%}
            <ul class="sub-menu mega-menu absolute flex">
              {%- for lv2 in linklists[block.settings.menu].links -%}
                <li class="menu-item flex-1">
                  <a href="{{ lv2.url }}" class="item-title"
                    ><span>{{ lv2.title | strip_html }}</span></a
                  >

                  {%- if lv2.links.size > 0 -%}
                    <ul class="level-2">
                      {%- for lv3 in lv2.links -%}
                        <li class="menu-item">
                          <a href="{{ lv3.url }}" class="item-title"
                            ><span>{{ lv3.title | strip_html }}</span></a
                          >

                          {%- if lv3.links.size > 0 -%}
                            <ul class="level-3">
                              {%- for lv4 in lv3.links -%}
                                <li class="menu-item">
                                  <a href="{{ lv4.url }}" class="item-title"
                                    ><span>{{ lv4.title | strip_html }}</span></a
                                  >
                                </li>
                              {%- endfor -%}
                            </ul>
                          {%- endif -%}
                        </li>
                      {%- endfor -%}
                    </ul>
                  {%- endif -%}
                </li>
              {%- endfor -%}

              {% if block.settings.banner1 and block.settings.baner1_link != blank %}
                <li>
                  <a href="{{ block.settings.baner1_link }}">
                    {{
                      block.settings.banner1
                      | image_url: width: 450
                      | image_tag: widths: '200, 300, 350', preload: boolean, loading: 'lazy', class: 'custom-class'
                    }}
                  </a>
                </li>
              {% endif %}
            </ul>
          {%- endif -%}
        </li>

      {%- when 'default' -%}
        {% if block.settings.link != blank %}
          <li id="item_{{block.id}}" class="menu-item type_simple">
            <a
              class="item-title"
              href="{% if block.settings.link != blank %}{{block.settings.link}}{% else %}#{% endif %}"
              target="{{block.settings.open_link}}"
            >
              <span>{{ block.settings.text | strip_html }}</span>
            </a>
          </li>
        {% endif %}

      {%- when 'link' -%}
      {%- else -%}
        <li
          id="item_{{block.id}}"
          class="type_{{block.type}} position-initial menu-item{% if linklists[block.settings.menu].links.size > 0 %} has-children {% endif %}"
        >
          <a
            class="item-title"
            href="{% if block.settings.link != blank %}{{block.settings.link}}{% else %}#{% endif %}"
            target="{{block.settings.open_link}}"
          >
            <span class="flex items-center gap-2">
              {{ block.settings.text | strip_html }}
              {% render 'icon-arrow-up', size: 14 %}
            </span>
          </a>

          <div class="sub-menu mega-menu absolute mega-menu1">
            <div
              id="bk_{{block.id}}"
              class="row lazy_menu_mega"
              data-include="{{search_url}}?q={{block.id}}&view=item_menu"
            ></div>
          </div>
        </li>
    {%- endcase -%}
  {% endfor %}
</ul>

<div class="article_item">
  <div class="relative">
    <div class="article_thumbnail">
      {% if article.image %}
        {{ article.image | image_url: width: 500 | image_tag: loading: 'lazy' }}
      {% endif %}
    </div>
    <div class="article_content">
      <h3 class="article_title">
        <a href="{{ article.url }}">{{ article.title }}</a>
      </h3>
    </div>
  </div>
</div>

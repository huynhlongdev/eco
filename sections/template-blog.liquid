{%- liquid
  assign limit = 9
-%}

{% paginate blog.articles by limit %}
  <div class="container">
    <div class="row">
      {% for article in blog.articles %}
        {% render 'content-blog', article: article %}
      {% endfor %}
    </div>

    {{- paginate | default_pagination }}
  </div>
{% endpaginate %}

{% schema %}
{
  "name": "Blog",
  "settings": [
    {
      "type": "number",
      "id": "limit",
      "label": "Post per page",
      "default": 9
    }
  ]
}
{% endschema %}

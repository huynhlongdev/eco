{% include 'product-res-variables' %}

{{ 'slick.min.js' | asset_url | script_tag }}
{{ 'slick.css' | asset_url | stylesheet_tag }}

<div class="container">
  {% if product %}
    <div class="product" id="product-{{ section.id }}" data-section="{{ section.id }}">
      <div class="row">
        <div class="col-md-7">
          <div class="product-images">
            {%- render 'product-media-gallery', product: product -%}
          </div>
        </div>

        <div class="col-md-5">
          <form method="post" action="/cart/add" id="{{ product.id }}" enctype="multipart/form-data" id="add-item-form">
            {%- for block in section.blocks -%}
              {%- case block.type -%}
                {%- when '@app' -%}
                  {% render block %}
                {% when 'text' %}
                  {{ block.settings.text }}
                {% when 'title' %}
                  <h1 class="product-title">{{ product.title }}</h1>
                {% when 'price' %}
                  <div class="product-price">
                    {%- if product.compare_at_price > price -%}
                      <span class="price price--sale" data-js-product-price
                        ><span id="product-price" class="current">{{ price | money }}</span>
                        <span class="compare">{{ product.compare_at_price | money }}</span></span
                      >
                    {%- else -%}
                      <span id="js-product-price" class="price" data-js-product-price>{{ price | money }}</span>
                    {%- endif -%}
                    {%- if product.compare_at_price > price -%}
                      <p class="price-sale-details" data-js-product-price-sale-details>
                        {%- assign price_save = product.compare_at_price | minus: price -%}
                        {%- assign price_save_money = price_save | money -%}
                        {%- assign price_save_procent = price
                          | times: 100
                          | divided_by: product.compare_at_price
                          | minus: 100
                          | times: -1
                        -%}
                      </p>
                    {%- endif -%}
                  </div>

                {% when 'quantity' %}
                  {% comment %}
                    <div class="custom flex gap-3 mb-4">
                      <label for="">
                        Advance
                        <input type="text" name="properties[Advance]">
                      </label>
                    </div>
                  {% endcomment %}

                  <div class="flex gap-3 mb-4">
                    {%- liquid
                      assign selected = product.selected_variant
                      assign available = selected.available
                    -%}
                    <div class="qty-input inline-flex bg-white border m-0 justify-evenly items-center">
                      <button
                        class="inline-flex items-center relative justify-center text-center border-0 qty-count qty-count--minus"
                        data-action="minus"
                        type="button"
                      >
                        -
                      </button>
                      <input
                        class="product-qty text-center inline-block items-center justify-center bg-transparent border-0"
                        type="number"
                        name="product-qty"
                        min="0"
                        max="10"
                        value="1"
                      >
                      <button
                        class="inline-flex items-center relative justify-center text-center border-0 qty-count qty-count--add"
                        data-action="add"
                        type="button"
                      >
                        +
                      </button>
                    </div>

                    <button
                      type="submit"
                      class="btn-add-cart flex items-center justify-center flex-1 overflow-hidden border-0 relative{% if available == false %} disable{% endif %}"
                    >
                      Add to cart
                      {% render 'icon-loading' %}
                    </button>
                  </div>

                {% when 'variant' %}
                  {% if product.variants.size > 1 %}
                    {% assign selected_variant = product.selected_or_first_available_variant %}
                    {% render 'product-swatch-variant',
                      selected_variant: selected_variant,
                      product: product,
                      block: block
                    %}
                  {% endif %}

                {% when 'share' %}
                  {% render 'share' %}
              {% endcase %}
            {% endfor %}

            {% if product.variants.size > 1 %}
              {% assign selected_variant = product.selected_or_first_available_variant %}
              <input type="hidden" name="id" value="{{ selected_variant.id }}">
            {% else %}
              <input type="hidden" name="id" value="{{ product.variants.first.id }}">
            {% endif %}
          </form>

          <div class="product-meta">
            <div>
              <div>
                <span
                  class="available {% if product.available %}  {% else %} d-none {% endif %}"
                  id="pr-available"
                >
                  {{- 'products.product.available' | t -}}
                </span>
                <span
                  class="unavailable {% if product.available %}d-none{% endif %}"
                  id="pr-unavailable"
                >
                  {{ 'products.product.unavailable' | t -}}
                </span>
              </div>
              <div>Vendor: {{ product.vendor | link_to_vendor }}</div>
              <div>
                Categories:
                {%- if product.collections.size > 0 -%}
                  {%- for collection in product.collections limit: 8 -%}
                    <a class="collection_item" href="{{ collection.url }}">
                      {{ collection.title -}}
                      {%- if forloop.last != true %},{% endif %}
                    </a>
                    {%- if forloop.last != true %} {% endif %}
                  {%- endfor -%}
                {%- endif -%}
              </div>

              {% if product.tags %}
                <div>
                  Tags:
                  {%- for tags in product.tags limit: 8 -%}
                    <a
                      href="{{ routes.root_url }}collections/all/{{ tags | replace: " ", "-"}}"
                      title="{{ tags}}"
                    >
                      <span>
                        {{- tags -}}
                        {%- if forloop.last != true %},{% endif %}
                      </span>
                    </a>
                  {% endfor %}
                </div>
              {% endif %}
            </div>
          </div>

          <script id="variant-json" type="application/json">
            {{ product.variants | json }}
          </script>
        </div>
      </div>
    </div>

    <div id="question" class="product-question" style="display:none">
      {% form 'contact', id: 'ContactForm', class: 'ct-contact-form' %}
        <!-- Name -->
        <div class="field">
          <input
            class="field__input"
            autocomplete="name"
            type="text"
            id="ContactForm-name"
            name="contact[Name]"
            value="{% if form.name %}{{ form.name }}{% elsif customer %}{{ customer.name }}{% endif %}"
            placeholder="Name"
            aria-required="true"
          >
          <label class="field__label" for="ContactForm-name">Name</label>
        </div>

        <div class="field field--with-error">
          <input
            autocomplete="email"
            type="email"
            id="ContactForm-email"
            class="field__input"
            name="contact[email]"
            spellcheck="false"
            autocapitalize="off"
            value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}"
            aria-required="true"
            {% if form.errors contains 'email' %}
              aria-invalid="true" aria-describedby="ContactForm-email-error"
            {% endif %}
            placeholder="Email"
          >
          <label class="field__label" for="ContactForm-email">
            Email
            <span aria-hidden="true">*</span></label
          >
          {%- if form.errors contains 'email' -%}
            <small class="contact__field-error" id="ContactForm-email-error">
              <span class="visually-hidden">Error</span>
              <span class="form__message">
                {{- form.errors.translated_fields.email | capitalize }}
                {{ form.errors.messages.email -}}
              </span>
            </small>
          {%- endif -%}
        </div>

        <div class="field">
          <input
            type="text"
            id="ContactForm-product"
            class="field__input"
            name="contact[product]"
            value="{{ product.title }}"
          >
        </div>

        <!-- Phone -->
        <div class="field">
          <input
            type="tel"
            id="ContactForm-phone"
            class="field__input"
            autocomplete="tel"
            name="contact[Phone]"
            pattern="[0-9\-]*"
            value="{% if form.phone %}{{ form.phone }}{% elsif customer %}{{ customer.phone }}{% endif %}"
            placeholder="Phone"
          >
          <label class="field__label" for="ContactForm-phone">Phone</label>
        </div>

        <!-- Message -->
        <div class="field">
          <textarea
            rows="10"
            id="ContactForm-body"
            class="text-area field__input"
            name="contact[Comment]"
            placeholder="Message"
          >
            {{- form.body -}}
          </textarea>
          <label class="form__label field__label" for="ContactForm-body"> Message </label>
        </div>

        <div class="contact__button">
          <button
            type="submit"
            class="button inline-block border-0 outline-none uppercase text-center cursor-pointer"
          >
            Send
          </button>
        </div>
      {% endform %}
    </div>
  {% else %}
    <div>Sorry, this product does not exist.</div>
  {% endif %}
</div>

<style>
  #product-{{ section.id }}{
    padding: {{ section.settings.section_spacing }}
  }
</style>

{% schema %}
{
  "name": "Product Template",
  "blocks": [
    {
      "type": "text",
      "name": "Text demo",
      "settings": [
        {
          "type": "inline_richtext",
          "id": "text",
          "label": "Text"
        }
      ]
    },
    {
      "type": "title",
      "name": "Title",
      "limit": 1
    },
    {
      "type": "price",
      "name": "Price",
      "limit": 1
    },
    {
      "type": "variant",
      "name": "Variant",
      "limit": 1,
      "settings": [
        {
          "type": "radio",
          "id": "variant_layout",
          "label": "Style",
          "options": [
            {
              "label": "Option Full",
              "value": "option_full"
            },
            {
              "label": "Option Type",
              "value": "option_type"
            },
            {
              "label": "Image",
              "value": "image"
            },
            {
              "label": "Color",
              "value": "color"
            }
          ],
          "default": "color"
        }
      ]
    },
    {
      "type": "share",
      "name": "Share",
      "limit": 1
    },
    {
    "type": "quantity",
    "name": "Quantity",
    "limit": 1
    }
  ],
  "settings": [
    {
      "type": "text",
      "id": "section_spacing",
      "label": "Spacing (Desktop)",
      "info": "Top right bottom left"
    },
    {
      "type": "checkbox",
      "id": "enable_sticky_info",
      "default": true,
      "label": "Enable sticky"
    }
  ],
  "presets": [
    {
      "name": "Product Main"
    }
  ]
}
{% endschema %}

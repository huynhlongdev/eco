{%- liquid
  assign handle_current = product.handle
  assign handle = product.collections[0].handle
  if handle == '' or handle == blank
    assign handle = 'frontpage'
  endif
  assign show_compare = false
  assign show_quick_view = false
  assign show_variant = false
  assign show_vendor = false
-%}

{% assign check_product = false %}
{% for product in collections[handle].products %}
  {% if handle_current != product.handle %}
    {% assign check_product = true %}
  {% endif %}
{% endfor %}

<div class="container">
  {%- if check_product -%}
    {%- if section.settings.title != blank -%}
      <h2 class="section-title">{{- section.settings.title -}}</h2>
    {%- endif -%}

    <div class="product-grid grid grid-cols-5 gap-4">
      {%- for related_product in collections[handle].products limit: 8 -%}
        {%- if related_product.id != product.id -%}
          {%-
            render 'content-product',
            product: related_product,
            show_quick_view: show_quick_view,
            show_compare: show_compare,
            show_variant: show_variant,
            show_vendor: show_vendor,
            image_ratio:
          -%}
        {%- endif -%}
      {%- endfor -%}
    </div>
  {%- endif -%}
</div>


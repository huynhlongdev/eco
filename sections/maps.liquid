{{ 'leaflet.js' | asset_url | script_tag }}
{{ 'leaflet.css' | asset_url | stylesheet_tag }}

{%- liquid
  if section.settings.scroll
    assign scroll = true
  else
    assign scroll = false
  endif

  assign icon = 'https://www.reshot.com/preview-assets/icons/W7VG495AYC/location-map-marker-W7VG495AYC.svg'
  if section.settings.icon != blank
    assign icon = section.settings.icon | image_url
  endif

  case section.settings.style
    when 'Mapnik'
      assign style = 'https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png'
    when 'CartoDB'
      assign style = 'https://{s}.basemaps.cartocdn.com/light_all/{z}/{x}/{y}{r}.png'
    else
      assign style = 'https://stamen-tiles-{s}.a.ssl.fastly.net/toner/{z}/{x}/{y}.png'
  endcase
-%}

<div class="map-container">
  <div class="{% if section.settings.fullscreen %}container-full{% else %}container{% endif %} relative">
    <div id="map"></div>
    <div id="points-list" class="absolute">
      <ul id="t_points"></ul>
    </div>
  </div>
</div>

<style>
    #shopify-section-{{ section.id }}{
    padding: {{section.settings.spacing}};
  }
  
  @media(min-width: 992px){
    #shopify-section-{{ section.id }}{
      padding: {{section.settings.spacing_lg}};
    }
  }

  #map {
    height: 500px;
    border-radius: 10px;
    overflow: hidden;
  }

  .leaflet-popup-content-wrapper {
    width: 100%;
  }

  #points-list{
    top: 1rem;
    right: 1rem;
    z-index: 7888888;
    background: #ffff;
    padding: 1rem;
    width: 300px;
  }

  #points-list li:hover{
    color: red;
    cursor: pointer;
  }
</style>

<script>
      var points = [
    {%- for block in section.blocks -%}
      ["{{- block.settings.title -}}", {{- block.settings.lat -}}, {{-block.settings.lng-}}] {%- if forloop.last == false -%}, {%- endif -%}
    {%- endfor -%}
  ];

  var iconSize = {{- section.settings.icon_size -}};

  var customIcon = L.icon({
    iconUrl: '{{- icon -}}',
    iconSize: [iconSize, iconSize],
    iconAnchor: [iconSize / 2, iconSize], // Nửa kích thước cho anchor
    popupAnchor: [0, -iconSize]
  });

  var buffers = [];

  {%- if section.blocks.size > 0 -%}

  var map = L.map('map', {
    scrollWheelZoom: {{ scroll }}
  }).setView([{{- section.blocks[0].settings.lat -}}, {{- section.blocks[0].settings.lng -}}], {{- section.settings.zoom -}});

  var OpenStreetMap_Mapnik = L.tileLayer('{{- style -}}', {
    maxZoom: 20,
    attribution: '&copy; <a href="http://www.openstreetmap.org/copyright">OpenStreetMap</a>'
  }).addTo(map);

  function addMarker(code, lat, lng) {
    {%- if section.settings.show_radius -%}
      var c = L.circle([lat, lng], {
        color: '{{- section.settings.background_color -}}',
        fillColor: '{{- section.settings.background_color -}}',
        fillOpacity: 0.5,
        radius: {{- section.settings.radius -}}
      }).addTo(map);
      buffers.push(c);
    {%- endif -%}

    var p = L.marker([lat, lng], { icon: customIcon });
    p.addTo(map).bindPopup(code).openPopup();

    addRowTable(code, [lat, lng]);
  }

  for (var i = 0; i < points.length; i++) {
    addMarker(points[i][0], points[i][1], points[i][2]);
  }

  // L.control.scale({maxWidth:240, metric:true, position: 'bottomleft'}).addTo(map);

  function addRowTable(code, coords) {
    var tr = document.createElement("li");
    var td = document.createElement("span");
    td.textContent = code;
    tr.appendChild(td);
    tr.onclick = function() { map.flyTo(coords, 17); };
    document.getElementById("t_points").appendChild(tr);
  }

  {%- endif -%}
</script>

{% schema %}
{
  "name": "Maps",
  "settings": [
    {
      "type": "checkbox",
      "id" : "fullscreen",
      "label": "Fullscreen",
      "default": true
    },
    {
      "type": "select",
      "id": "style",
      "label": "Style",
      "options": [
        {
          "label": "Mapnik",
          "value": "Mapnik"
        },
        {
          "label": "CartoDB",
          "value": "CartoDB"
        },
        {
          "label": "Stamen",
          "value": "Stamen"
        }
      ],
      "default": "Mapnik"
    },
    {
      "type": "checkbox",
      "id" : "show_location",
      "label": "Show icon",
      "default": true
    },
    {
      "type": "image_picker",
      "id": "icon",
      "label": "Icon"
    },
    {
      "type": "range",
      "id": "icon_size",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Icon size",
      "default": 40
    },
    {
      "type": "checkbox",
      "id" : "scroll",
      "label": "Disable scroll",
      "default": false
    },
    {
      "type": "range",
      "id": "zoom",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Zoom",
      "default": 18
    },
    {
      "type": "checkbox",
      "id" : "show_radius",
      "label": "Show radius",
      "default": true
    },
    {
      "type": "range",
      "id": "radius",
      "min": 1,
      "max": 10,
      "step": 1,
      "unit": "px",
      "label": "Radius",
      "default": 2
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#f88787"
    },
    {
      "type": "text",
      "id": "spacing_lg",
      "label": "Spacing (Desktop / Laptop / tablet)",
      "default": "70px 0 0 70px",
      "info": "Note: Top right bottom left. Docs [here](https://www.w3schools.com/css/css_padding.asp)"
    },
    {
      "type": "text",
      "id": "spacing",
      "label": "Spacing (Mobile)",
      "default": "60px 0 0 60px",
      "info": "Note: Top right bottom left. Docs [here](https://www.w3schools.com/css/css_padding.asp)"
    }

  ],
  "blocks": [
    {
      "type": "location",
      "name": "Location",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title"
        },
        {
          "type": "text",
          "id": "lat",
          "label": "Latitude"
        },
        {
          "type": "text",
          "id": "lng",
          "label": "Longitude"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Maps"
    }
  ]
}
{% endschema %}

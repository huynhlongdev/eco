{%- liquid
  assign collection = section.settings.collection
  assign heading = section.settings.heading
-%}

<div class="container">
  <div class="row">
    {% if collection != blank %}
      {% assign new_products = collections[collection].products | sort: 'created_at' %}
      {% if heading != blank %}
        <h2>{{ heading | strip_html }}</h2>
      {% endif %}

      {% for product in new_products %}
        <div class="col-md-2">
          <a href="{{ product.url }}">
            <img src="{{ product.featured_image | img_url: 'medium' }}" alt="{{ product.title }}">
            <h3>{{ product.title }}</h3>
          </a>
        </div>
      {% endfor %}
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "Product Home",
  "class": "product-home",
  "settings": [
    {
      "type": "textarea",
      "id": "heading",

{%- liquid
  assign arr_terms = search.terms |split:'product_type:'
  assign search_terms = arr_terms[0] | strip 
  assign search_terms_filter = search_terms |split:'*'
  assign search_terms = search_terms_filter[0] | strip 
  assign product_type = arr_terms[1] | strip
-%}

<div class="page-title text-{{ section.settings.alignment }}">
  <div class="container mx-auto">
   
  {% comment %} {{ section.settings.heading_font }}
    <h1>{{ section.settings.headline }}</h1> {% endcomment %}

    {% if search.results.size < 1 %}
      <h1 class="h2">Your search for "" did not yield any results</h1>
    {% else %}
        {% for item in search.results %}
          {{ item.object_type |  json }}
        {% endfor %}
    {% endif %}

    
  </div>
</div>

<style>
  #shopify-section-{{ section.id }}{
    padding: {{section.settings.spacing}};
  }
  
  @media(min-width: 992px){
    #shopify-section-{{ section.id }}{
      padding: {{section.settings.spacing_lg}};
    }
  }
</style>

{% schema %}
{
  "name": "Search result",
  "class": "page-title",
  "settings": [
    {
      "type": "text",
      "id": "spacing_lg",
      "label": "Spacing (Desktop / Laptop / tablet)",
      "default": "70px 0 70px 0px",
      "info": "Note: Top right bottom left. Docs [here](https://www.w3schools.com/css/css_padding.asp)"
    },
    {
      "type": "text",
      "id": "spacing",
      "label": "Spacing (Mobile)",
      "default": "60px 0 60px 0",
      "info": "Note: Top right bottom left. Docs [here](https://www.w3schools.com/css/css_padding.asp)"
    }
  ]
}
{% endschema %}

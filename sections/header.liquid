{%- liquid
  assign se_blocks = section.blocks
  assign tp_blocks = se_blocks | map: 'type' | join: ',' | remove: ',link' | split: ','
-%}

{%- if template.suffix == 'item_menu' and template.name == 'search' -%}
  {%- render 'menu_import', section: section -%}
{%- else -%}
  {% assign hlayout = settings.header_layout %}
  <header class="header relative {{ hlayout }}">
    {% case hlayout %}
      {% when 'header-1' %}
        {% render 'header-1', settion: section.settings, tp_blocks: tp_blocks, se_blocks: se_blocks %}
      {% else %}
        {% render 'header-2', settion: section.settings, tp_blocks: tp_blocks, se_blocks: se_blocks %}
    {% endcase %}
  </header>
{%- endif -%}

<script></script>

<script>

  function count_wishlist(){
    let wishlist = localStorage.getItem('wishlist');
    let count = wishlist ? wishlist.split(',').filter(Boolean).length : 0;
    $('.wishlist-count').text(count);
  }

  function mega_menu(){
    $('.lazy_menu_mega').each(function(){
        const $this = $(this); // cache the element
        const view = $this.data('include');
        fetch(`${window.location.origin}/search/${view}`)
            .then(res => res.ok ? res.text() : Promise.reject('Network response was not ok'))
            .then(data => $this.html(data))
            .catch(error => console.error('>>>Fetch error:', error));
    });
  }
  
  jQuery(document).ready(function($){
      count_wishlist();
      mega_menu();
  })
</script>


<div class="container">
  <div class="row">
    {% for block in section.blocks %}
      <div id="{{block.id}}" class="col-md-4">
        <a href="" class="block relative">
          {% if block.settings.image %}
            {{ block.settings.image | image_url: width: 600 | image_tag }}
          {% endif %}
          <div class="card-content p-4 absolute top-0 left-0 w-100 h-100">
            <h3>{{ block.settings.title }}</h3>
            <p>{{ block.settings.sub_title }}</p>
          </div>
        </a>
      </div>
    {% endfor %}
  </div>
</div>

{% style %}
  #shopify-section-{{ section.id }}{
    padding: {{section.settings.spacing}};
  }

  @media(min-width: 992px){
    #shopify-section-{{ section.id }}{
      padding: {{section.settings.spacing_lg}};
    }
  }
{% endstyle %}

{% schema %}
{
  "name": "Card Images",
  "tag": "div",
  "class": "card-images",
  "settings": [
    {
      "type": "text",
      "id": "spacing_lg",
      "label": "Spacing (Desktop / Laptop / tablet)",
      "default": "70px 0 70px 0",
      "info": "Note: Top right bottom left. Docs [here](https://www.w3schools.com/css/css_padding.asp)"
    },
    {
      "type": "text",
      "id": "spacing",
      "label": "Spacing (Mobile)",
      "default": "60px 0 60px 0",
      "info": "Note: Top right bottom left. Docs [here](https://www.w3schools.com/css/css_padding.asp)"
    }
  ],
  "max_blocks": 6,
  "blocks": [
     {
       "name": "Card",
       "type": "card",
       "settings": [
         {
           "type": "image_picker",
           "id": "image",
           "label": "Image"
         },
        {
          "type": "textarea",
          "id": "title",
          "label": "Title"
        },
        {
          "type": "textarea",
          "id": "sub_title",
          "label": "Sub title"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
         }
       ]
     }
  ],
  "presets": [
    {
      "name": "Card Images"
    }
  ]

}
{% endschema %}

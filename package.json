{
  "devDependencies": {
    "concurrently": "^8.2.2",
    "tailwindcss": "^3.4.10"
  },
  "scripts": {
    "dev": "concurrently -c \"auto\" \"npm:dev:*\"",
    "dev:shopify": "shopify theme dev",
    "deploy": "shopify theme push --publish --allow-live",
    "watch": "concurrently -c \"auto\" \"npm run dev:shopify\" \"npm run deploy -- --watch\""
  }
}
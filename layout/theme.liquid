<!doctype html>
<html class="js" lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="theme-color" content="">
    <link rel="canonical" href="{{ canonical_url }}">

    {%- if settings.favicon != blank -%}
      <link rel="shortcut icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
    {%- endif -%}

    <title>
      {{ page_title }}
      {%- if current_tags %} &ndash; tagged "{{ current_tags | join: ', ' }}"{% endif -%}
      {%- if current_page != 1 %} &ndash; Page {{ current_page }}{% endif -%}
      {%- unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless -%}
    </title>

    {% if page_description %}
      <meta name="description" content="{{ page_description | escape }}">
    {% endif %}

    {% render 'meta-tags' %}

    {{ content_for_header }}

    {{ 'bootstrap.min.css' | asset_url | stylesheet_tag }}
    {{ 'global.css' | asset_url | stylesheet_tag }}
    {{ 'style.css' | asset_url | stylesheet_tag }}
    {{ 'product.css' | asset_url | stylesheet_tag }}

    <link rel="stylesheet" href="{{ 'main.css' | asset_url }}" type="text/css" onload="this.media='all'">

    {{ 'jquery.min.js' | asset_url | script_tag }}
  </head>

  <body class="">
    <!-- header -->
    {{ 'header.css' | asset_url | stylesheet_tag }}
    <div class="header-wrapper">
      {% section 'header-top' %}
      {% section 'header' %}
    </div>
    <!-- end header -->

    <main class="main">
      {{ content_for_layout }}
    </main>
    <!-- content-for-layout -->

    {% if template contains 'product' %}
      {% section 'product-tab' %}
      {% section 'related-product-carousel' %}
    {% endif %}

    <!-- footer -->
    {% sections 'footer-group' %}
    <!-- end footer -->

    <!-- back to top -->
    {% render 'back-to-top' %}
    <!-- end back to top -->

    {% if settings.enable_cart_drawer %}
      <!-- start cart drawer -->
      {% render 'cart-drawer' %}
      <!-- end cart drawer -->
    {% endif %}

    {% comment %} fancybox {% endcomment %}
    {{ 'jquery.fancybox.min.css' | asset_url | stylesheet_tag }}
    <script src="{{ 'jquery.fancybox.min.js' | asset_url }}" defer></script>

    {% comment %} bootstrap {% endcomment %}
    <script src="{{ 'popper.min.js' | asset_url }}" defer></script>
    <script src="{{ 'bootstrap.min.js' | asset_url }}" defer></script>

    {% comment %} main {% endcomment %}
    <script src="{{ 'main.js' | asset_url }}" defer></script>

    {% comment %} wishlist {% endcomment %}
    <script src="{{ 'wishlist.js' | asset_url }}" defer></script>

    {% comment %} cart {% endcomment %}
    {{ 'cart.js' | asset_url | script_tag }}

    {{ 'jquery.range-min.js' | asset_url | script_tag }}
    {{ 'product.js' | asset_url | script_tag }}

    <script>
      const titleChanger = {
        messages: ["🔥 Don't forget this...", '⚡ Come Back Now'],
        delay: 1000,
        titleTag: document.getElementsByTagName('title')[0],
        originalTitle: '',
        isSingle: false,
        isActive: false,
        timer: null,

        init() {
          if (!this.titleTag) return;

          this.originalTitle = this.titleTag.innerText;
          this.isSingle = this.messages.length < 2;

          document.addEventListener('visibilitychange', () => {
            if (document.visibilityState === 'visible') {
              this.handleVisible();
            } else {
              this.handleHidden();
            }
          });
        },

        handleVisible() {
          if (!this.isActive) return;

          clearInterval(this.timer);
          this.titleTag.innerText = this.originalTitle;
          this.isActive = false;
        },

        handleHidden() {
          if (this.isActive) return;

          let index = 0;
          this.isActive = true;
          this.titleTag.innerText = this.messages[index];

          if (this.isSingle) return;

          this.timer = setInterval(() => {
            index = (index + 1) % this.messages.length;
            this.titleTag.innerText = this.messages[index];
          }, this.delay);
        },
      };

      titleChanger.init();
      document.addEventListener('DOMContentLoaded', function () {});

      window.LPSettings = {
        pleaseChooseOptions: `Please select some product options before adding this product to your cart.`,
        addToCart: `{{ 'products.product.add_to_cart' | t }}`,
        selectOption: `Select options`,
        quickShop: `Quick Shop`,
        compare: `Compare`,
        added_text_cp: `Compare products`,
        add_to_wishlist: `Add to Wishlist`,
        remove_wishlist: `Remove Wishlist`,
        browse_wishlist: `Browse Wishlist`
      };
    </script>
  </body>
</html>

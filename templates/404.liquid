{% style %}
  :root{
    --blue-light: #00a6fb;   /* Màu xanh dương nhạt */
    --blue-medium: #0582ca;  /* Màu xanh dương trung bình */
    --blue-dark: #006494;    /* Màu xanh dương đậm */
    --blue-deep: #003554;    /* Màu xanh rất đậm, gần xanh đen */
    --blackish-blue: #051923;/* Màu đen xanh */
  }
  .heading-404{
    font-size: 180px;
    font-weight: 700;
    color: var(--blackish-blue);
    text-shadow: -6px 0px var(--blue-dark);
  }
  .btn{
    padding: 8px 24px;
  }
  .button-primary{
    background: var(--blackish-blue);
  }
  .btn:hover {
    background: var(--blue-dark);
      color: #fff;
  }
  @media (max-width: 470px){
    .heading-404 {
        font-size: 140px;
    }
  }
{% endstyle %}

<div class="er-404 flex flex-wrap items-center justify-center w-100 py-5">
  {{ content_for_layout }}

  <div class="text-center">
    <h1 class="heading-404 mt-0 pt-0">404</h1>

    <div class="block">
      <p>{{ '404.message' | t }}</p>
    </div>

    <a href="{{ shop.url }}" class="btn button-primary text-white text-uppercase">{{- '404.go_to_home' | t -}}</a>
  </div>
</div>
